{
  "manifest_version": 3,
  "name": "POPO 稳定下载助手",
  "version": "0.7.1",
  "version_name": "0.7.1",
  "key": "",
  "description": "扫描 POPO 团队空间文件夹，并以可暂停、可重试、可核对的队列逐个下载文件。",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/popo-logo-16.png",
    "32": "assets/popo-logo-32.png",
    "48": "assets/popo-logo-48.png",
    "128": "assets/popo-logo-128.png"
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.popo.netease.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "POPO 稳定下载助手",
    "default_icon": {
      "16": "assets/popo-logo-16.png",
      "32": "assets/popo-logo-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.popo.netease.com/*"
      ],
      "js": [
        "page-api.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://docs.popo.netease.com/*"
      ],
      "js": [
        "core.js",
        "queue.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.popo.netease.com/*"
      ],
      "js": [
        "runtime/page-ui.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/popo-logo.svg"
      ],
      "matches": [
        "https://docs.popo.netease.com/*"
      ]
    }
  ]
}
