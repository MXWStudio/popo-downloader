{
  "manifest_version": 3,
  "name": "POPO 稳定下载助手",
  "version": "0.6.0.3",
  "version_name": "0.6.0-beta.3",
  "key": "",
  "description": "扫描 POPO 团队空间文件夹，并以可暂停、可重试、可核对的队列逐个下载文件。",
  "minimum_chrome_version": "114",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.popo.netease.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "POPO 稳定下载助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.popo.netease.com/*"
      ],
      "js": [
        "page-api.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://docs.popo.netease.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
